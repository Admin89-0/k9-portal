# Copy to .env for local work. On Replit, set these in the Secrets panel instead.
# Never commit real values.

# Postgres connection string (Replit provides this when a database is added)
DATABASE_URL=postgres://user:password@localhost:5432/k9_portal

PORT=3000

# Phase 1 and later. Leave blank until each integration is approved.
# Use TEST / SANDBOX credentials only until the live pilot is approved.
GHL_PRIVATE_INTEGRATION_TOKEN=
GHL_LOCATION_ID=
SQUARE_ACCESS_TOKEN=
SQUARE_WEBHOOK_SIGNATURE_KEY=
STRIPE_RESTRICTED_KEY=
STRIPE_WEBHOOK_SECRET=
